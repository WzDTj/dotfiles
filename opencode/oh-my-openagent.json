{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "medium"
        }
      ],
      "ultrawork": {
        "model": "openai/gpt-5.5",
        "variant": "high"
      },
      "prompt_append": "Always consult prometheus and atlas for planning. Never rush to implementation."
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "medium"
        }
      ],
      "prompt_append": "Follow established plans precisely. Ask for clarification when plans are ambiguous."
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "high"
        },
        {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "variant": "high"
        }
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 120000
      }
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "openai/gpt-5-nano"
        },
        {
          "model": "github-copilot/gpt-5-nano"
        }
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "high"
        },
        {
          "model": "github-copilot/gemini-3.1-pro-preview"
        }
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 160000
      },
      "prompt_append": "Interview extensively. Question assumptions. Build exhaustive plans with milestones, risks, and contingencies. Use deep & quick agents heavily in parallel for research."
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "high"
        }
      ],
      "prompt_append": "Critically evaluate plans. Identify gaps, risks, and improvements. Be thorough."
    },
    "momus": {
      "model": "github-copilot/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "variant": "high"
        }
      ],
      "prompt_append": "Challenge all assumptions in plans. Look for edge cases, failure modes, and overlooked requirements."
    },
    "atlas": {
      "model": "github-copilot/claude-sonnet-4.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "medium"
        }
      ],
      "prompt_append": "Preserve context across long planning sessions. Track evolving decisions."
    },
    "sisyphus-junior": {
      "model": "github-copilot/claude-sonnet-4.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "medium"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "variant": "high"
        }
      ]
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.5",
          "variant": "medium"
        },
        {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "variant": "high"
        }
      ]
    },
    "artistry": {
      "model": "github-copilot/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5"
        },
        {
          "model": "github-copilot/gpt-5.5"
        }
      ]
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        {
          "model": "github-copilot/gpt-5.4-mini"
        },
        {
          "model": "github-copilot/claude-haiku-4.5"
        },
        {
          "model": "github-copilot/gemini-3-flash-preview"
        }
      ]
    },
    "unspecified-low": {
      "model": "github-copilot/claude-sonnet-4.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.3-codex",
          "variant": "medium"
        },
        {
          "model": "github-copilot/gemini-3-flash-preview"
        }
      ]
    },
    "unspecified-high": {
      "model": "github-copilot/claude-sonnet-4.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.3-codex",
          "variant": "medium"
        },
        {
          "model": "github-copilot/gemini-3-flash-preview"
        }
      ]
    },
    "writing": {
      "model": "github-copilot/gemini-3-flash-preview",
      "fallback_models": [
        {
          "model": "github-copilot/claude-sonnet-4.6"
        }
      ]
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "openai": 3
    },
    "modelConcurrency": {
      "openai/gpt-5.5": 3
    }
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "sisyphus_agent": {
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": true
  },
  "hashline_edit": true,
  "experimental": {
    "aggressive_truncation": true
  }
}
